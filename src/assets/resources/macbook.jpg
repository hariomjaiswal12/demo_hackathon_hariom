<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="800" height="450">
    <defs>
      <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#0f172a"/>
        <stop offset="50%" stop-color="#1e293b"/>
        <stop offset="100%" stop-color="#3b82f6"/>
      </linearGradient>
      <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="1" opacity="0.05"/>
      </pattern>
    </defs>
    <rect width="800" height="450" fill="url(#bg)"/>
    <rect width="800" height="450" fill="url(#grid)"/>
    
    <g transform="translate(0, 0)">
      <rect x="260" y="140" width="280" height="170" rx="12" fill="#1e293b" stroke="#60a5fa" stroke-width="4"/>
           <path d="M220 310 L 580 310 L 560 330 L 240 330 Z" fill="#475569" stroke="#94a3b8" stroke-width="2"/>
           <circle cx="400" cy="225" r="24" fill="none" stroke="#60a5fa" stroke-width="3"/>
           <path d="M390 225 L 410 225 M 400 215 L 400 235" stroke="#60a5fa" stroke-width="3"/>
    </g>
    
    <rect x="0" y="350" width="800" height="100" fill="rgba(15, 23, 42, 0.75)"/>
    <text x="40" y="390" font-family="system-ui, -apple-system, sans-serif" font-weight="800" font-size="28" fill="#ffffff">MacBook Pro 14</text>
    <text x="40" y="420" font-family="system-ui, -apple-system, sans-serif" font-weight="600" font-size="16" fill="#60a5fa">HARDWARE • M3 Pro</text>
    <rect x="700" y="380" width="60" height="30" rx="15" fill="#60a5fa" opacity="0.9"/>
    <circle cx="730" cy="395" r="6" fill="#ffffff"/>
  </svg>